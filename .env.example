# Copy to .env (or .env.<stage>) and fill in for your deploy target.
# SST loads both automatically; neither is committed.

# Host serving /api and /streams
# SST deploys to a CloudFront origin, so it must be a *different* host from
# RADIO_SITE_DOMAIN below. Point it at the backend directly, never at the
# distribution, or the /api and /streams behaviors fetch from themselves.
RADIO_ORIGIN_DOMAIN=origin.example.com

# Public host for the site. Optional — when unset the deploy is reachable only
# at its generated *.cloudfront.net name. Must differ from RADIO_ORIGIN_DOMAIN.
# RADIO_SITE_DOMAIN=example.com

# ACM certificate ARN, us-east-1. Set this when the domain's DNS is hosted
# somewhere SST cannot write records to: create and validate the certificate
# yourself, then add the alias records by hand. Leave unset for a Route53-hosted
# domain, and SST requests the certificate and writes every record itself.
# RADIO_SITE_CERT_ARN=arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000

# Server-side API base for the Next.js app.
# Defaults to https://$RADIO_ORIGIN_DOMAIN/api when unset.
# RADIO_BACKEND_PATH=https://radio.example.com/api

# Deploy region. Falls back to normal AWS SDK resolution when unset.
# AWS_REGION=us-east-1
